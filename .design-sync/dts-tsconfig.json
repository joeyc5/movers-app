{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "incremental": false,
    "skipLibCheck": true,
    "outDir": "../dist",
    "rootDir": "../src",
    "types": ["react", "node"]
  },
  "include": [
    "../src/components/**/*.ts",
    "../src/components/**/*.tsx",
    "../src/lib/utils.ts",
    "../src/hooks/**/*.ts",
    "../src/hooks/**/*.tsx"
  ],
  "exclude": ["../node_modules"]
}
